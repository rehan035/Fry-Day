<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
/* ============================================================
   MENU DATA
   Replace names, prices, descriptions and image URLs with your
   real menu. Images use Unsplash's CDN with stable photo IDs —
   swap them for your own product photos for authenticity.
   ============================================================ */
const CATEGORIES = ["All","Burgers","Wings","Loaded Fries","Sides","Drinks"];

const PRODUCTS = [
  { id:1,  name:"Classic Frydays Burger",   cat:"Burgers",      price:650, tag:"Best seller", desc:"Beef patty, cheddar, pickles, house sauce.",            img:"https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=700&q=80" },
  { id:2,  name:"Crispy Chicken Burger",    cat:"Burgers",      price:620, tag:"",            desc:"Buttermilk-fried chicken, slaw, spicy mayo.",          img:"https://images.unsplash.com/photo-1606755962773-d324e0a13086?auto=format&fit=crop&w=700&q=80" },
  { id:3,  name:"Double Smash",             cat:"Burgers",      price:890, tag:"New",         desc:"Two smashed patties, double cheese, onions.",          img:"https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=700&q=80" },
  { id:4,  name:"Buffalo Wings (6pc)",      cat:"Wings",        price:520, tag:"Spicy",       desc:"Tossed in buffalo sauce, blue cheese dip.",            img:"https://images.unsplash.com/photo-1608039755401-742074f0548d?auto=format&fit=crop&w=700&q=80" },
  { id:5,  name:"Honey Garlic Wings (6pc)", cat:"Wings",        price:540, tag:"",            desc:"Sticky honey garlic glaze, sesame.",                    img:"https://images.unsplash.com/photo-1567620832903-9fc6debc209f?auto=format&fit=crop&w=700&q=80" },
  { id:6,  name:"Loaded Cheese Fries",      cat:"Loaded Fries", price:480, tag:"Best seller", desc:"Fries, cheese sauce, jalapeños, spring onion.",          img:"https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=700&q=80" },
  { id:7,  name:"Chicken Tikka Fries",      cat:"Loaded Fries", price:560, tag:"",            desc:"Tikka chunks, mint mayo, crispy onions.",              img:"https://images.unsplash.com/photo-1585109649139-366815a0d713?auto=format&fit=crop&w=700&q=80" },
  { id:8,  name:"Classic Salted Fries",     cat:"Sides",        price:250, tag:"",            desc:"Hand-cut daily, double-fried, sea salt.",              img:"https://images.unsplash.com/photo-1576107232684-1279f390859f?auto=format&fit=crop&w=700&q=80" },
  { id:9,  name:"Onion Rings (8pc)",        cat:"Sides",        price:320, tag:"",            desc:"Beer-battered, crunchy, with ranch.",                  img:"https://images.unsplash.com/photo-1639024471283-03518883512d?auto=format&fit=crop&w=700&q=80" },
  { id:10, name:"Coleslaw",                 cat:"Sides",        price:180, tag:"",            desc:"Fresh cabbage, carrot, creamy dressing.",              img:"https://images.unsplash.com/photo-1625938145313-8e4f0b8b8e0e?auto=format&fit=crop&w=700&q=80" },
  { id:11, name:"Soft Drink",               cat:"Drinks",       price:120, tag:"",            desc:"Chilled can — Coke, Sprite or Fanta.",                 img:"https://images.unsplash.com/photo-1581636625402-29b2a704ef13?auto=format&fit=crop&w=700&q=80" },
  { id:12, name:"Fresh Lemonade",           cat:"Drinks",       price:220, tag:"New",         desc:"Squeezed to order, lightly sweetened.",                img:"https://images.unsplash.com/photo-1621263764928-df1444c5e859?auto=format&fit=crop&w=700&q=80" }
];

/* ============================================================
   SAFE STORAGE (private mode / disabled storage)
   ============================================================ */
const storage = {
  get(k){
    try { return localStorage.getItem(k); } catch(e){ return null; }
  },
  set(k,v){
    try { localStorage.setItem(k,v); } catch(e){ /* ignore */ }
  }
};

/* ============================================================
   STATE
   ============================================================ */
let activeCat = "All";
let cart = {};
try {
  const raw = storage.get("frydays_cart");
  if(raw) cart = JSON.parse(raw) || {};
} catch(e){ cart = {}; }

/* ============================================================
   HELPERS
   ============================================================ */
const $  = (s,r=document)=>r.querySelector(s);
const $$ = (s,r=document)=>[...r.querySelectorAll(s)];
const fmt = n => "Rs. " + n.toLocaleString("en-PK");

/* ============================================================
   CATEGORIES
   ============================================================ */
function renderChips(){
  const wrap = $("#chips");
  wrap.innerHTML = "";
  CATEGORIES.forEach(cat=>{
    const b = document.createElement("button");
    b.className = "chip" + (cat===activeCat?" active":"");
    b.textContent = cat;
    b.setAttribute("role","tab");
    b.setAttribute("aria-selected", cat===activeCat ? "true":"false");
    b.onclick = ()=>{
      if(activeCat === cat) return;
      activeCat = cat;
      renderChips();
      renderProducts(true);
    };
    wrap.appendChild(b);
  });
}

/* ============================================================
   PRODUCTS
   ============================================================ */
function renderProducts(animate){
  const grid = $("#productGrid");

  const paint = ()=>{
    grid.innerHTML = "";
    const list = activeCat==="All" ? PRODUCTS : PRODUCTS.filter(p=>p.cat===activeCat);
    $("#resultCount").textContent = list.length===0
      ? "No items in this category"
      : `Showing ${list.length} item${list.length!==1?"s":""}`;

    list.forEach(p=>{
      const card = document.createElement("article");
      card.className = "card reveal";
      card.innerHTML = `
        <div class="card-img">
          ${p.tag ? `<span class="tag">${p.tag}</span>` : ""}
          <img src="${p.img}" alt="${p.name}" loading="lazy" decoding="async" />
        </div>
        <div class="card-body">
          <h3>${p.name}</h3>
          <p>${p.desc}</p>
          <div class="card-foot">
            <span class="price">${fmt(p.price)}<small>PKR</small></span>
            <button class="add-btn" aria-label="Add ${p.name} to cart" data-id="${p.id}">+</button>
          </div>
        </div>`;
      grid.appendChild(card);

      // Image load state (removes shimmer)
      const img = card.querySelector("img");
      const imgWrap = card.querySelector(".card-img");
      const markLoaded = ()=>{ img.classList.add("loaded"); imgWrap.classList.add("loaded"); };
      if(img.complete && img.naturalWidth > 0) markLoaded();
      else img.addEventListener("load", markLoaded, {once:true});
      img.addEventListener("error", ()=>{
        imgWrap.classList.remove("loaded");
        img.style.background = "var(--paper-2)";
        img.alt = p.name + " (image unavailable)";
      }, {once:true});
    });

    $$(".add-btn", grid).forEach(b=>{
      b.onclick = ()=> addToCart(Number(b.dataset.id));
    });

    observeReveals();
  };

  if(animate){
    grid.classList.add("filtering");
    setTimeout(()=>{ paint(); grid.classList.remove("filtering"); }, 180);
  } else {
    paint();
  }
}

/* ============================================================
   CART
   ============================================================ */
function saveCart(){ storage.set("frydays_cart", JSON.stringify(cart)); }

function addToCart(id){
  const p = PRODUCTS.find(x=>x.id===id);
  if(!p) return;
  cart[id] = (cart[id]||0) + 1;
  saveCart();
  toast(`${p.name} added to bag`);
  updateCartUI();
  bounceCartBadge();
}

function changeQty(id, delta){
  cart[id] = (cart[id]||0) + delta;
  if(cart[id] <= 0) delete cart[id];
  saveCart();
  updateCartUI();
  if(Object.keys(cart).length === 0) closeCartModal();
}

function cartTotals(){
  let count = 0, total = 0;
  for(const id in cart){
    const p = PRODUCTS.find(x=>x.id === Number(id));
    if(!p) continue;
    count += cart[id];
    total += p.price * cart[id];
  }
  return { count, total };
}

function bounceCartBadge(){
  const badge = $("#cartCount");
  badge.style.transform = "scale(1.35)";
  setTimeout(()=>{ badge.style.transform = ""; }, 220);
}

function updateCartUI(){
  const { count, total } = cartTotals();
  const badge = $("#cartCount");
  badge.textContent = count;
  badge.classList.toggle("on", count > 0);

  /* Loyalty: 1 point per Rs.100 spent */
  const pts = Math.floor(total / 100);
  const progress = Math.min(100, pts);
  $("#pointsBig").innerHTML = `${pts} <span>pts</span>`;
  requestAnimationFrame(()=>{ $("#progressBar").style.width = progress + "%"; });
  $("#pointsMsg").textContent = pts >= 100
    ? "You've unlocked a free meal."
    : pts > 0
      ? `${100 - pts} more points to your free meal.`
      : "Add items to start earning.";

  /* Cart modal contents */
  const wrap = $("#cartItems");
  wrap.innerHTML = "";

  if(count === 0){
    wrap.innerHTML = `<p class="empty">Your bag is empty. Add something tasty.</p>`;
    $("#cartTotal").textContent = "Rs. 0";
    return;
  }

  for(const id in cart){
    const p = PRODUCTS.find(x=>x.id === Number(id));
    if(!p) continue;
    const line = document.createElement("div");
    line.className = "cart-line";
    line.innerHTML = `
      <div class="line-info">
        <div class="line-name">${p.name}</div>
        <div class="line-price">${fmt(p.price)} each</div>
      </div>
      <div class="qty">
        <button data-act="minus" data-id="${p.id}" aria-label="Remove one ${p.name}">−</button>
        <span>${cart[id]}</span>
        <button data-act="plus"  data-id="${p.id}" aria-label="Add one ${p.name}">+</button>
      </div>`;
    wrap.appendChild(line);
  }
  $$(".qty button", wrap).forEach(b=>{
    b.onclick = ()=> changeQty(Number(b.dataset.id), b.dataset.act === "plus" ? 1 : -1);
  });
  $("#cartTotal").textContent = fmt(total);
}

/* ============================================================
   MODAL (with focus trap)
   ============================================================ */
const modal = $("#cartModal");
let lastFocus = null;

function openCartModal(){
  lastFocus = document.activeElement;
  modal.classList.add("open");
  document.body.classList.add("no-scroll");
  setTimeout(()=> $("#custName").focus(), 60);
  trapFocus();
}
function closeCartModal(){
  modal.classList.remove("open");
  document.body.classList.remove("no-scroll");
  if(lastFocus && lastFocus.focus) lastFocus.focus();
}

function trapFocus(){
  const focusables = $$(
    'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
    modal
  ).filter(el=>!el.disabled && el.offsetParent !== null);
  if(focusables.length === 0) return;
  const first = focusables[0], last = focusables[focusables.length - 1];

  if(!modal._trap){
    modal._trap = (e)=>{
      if(e.key !== "Tab") return;
      if(e.shiftKey && document.activeElement === first){
        e.preventDefault(); last.focus();
      } else if(!e.shiftKey && document.activeElement === last){
        e.preventDefault(); first.focus();
      }
    };
    modal.addEventListener("keydown", modal._trap);
  }
}

$("#cartBtn").onclick = openCartModal;
$("#closeCart").onclick = closeCartModal;
modal.addEventListener("click", e=>{ if(e.target === modal) closeCartModal(); });
document.addEventListener("keydown", e=>{
  if(e.key === "Escape" && modal.classList.contains("open")) closeCartModal();
});

/* ============================================================
   CHECKOUT
   ============================================================ */
function validatePhone(v){
  // Accept 03xx xxxxxxx (PK mobile), with optional spaces/dashes/+92
  const digits = v.replace(/[\s\-()]/g,"").replace(/^\+?92/,"0");
  return /^03\d{9}$/.test(digits);
}

$("#placeOrder").onclick = ()=>{
  const nameEl  = $("#custName");
  const phoneEl = $("#custPhone");
  const name  = nameEl.value.trim();
  const phone = phoneEl.value.trim();
  const { count, total } = cartTotals();

  nameEl.classList.remove("invalid");
  phoneEl.classList.remove("invalid");

  if(count === 0){ toast("Your bag is empty."); return; }
  if(!name){
    nameEl.classList.add("invalid");
    nameEl.focus();
    toast("Please add your name.");
    return;
  }
  if(!validatePhone(phone)){
    phoneEl.classList.add("invalid");
    phoneEl.focus();
    toast("Enter a valid mobile number (03xx xxxxxxx).");
    return;
  }

  toast(`Order placed — ${fmt(total)}. We'll call you shortly.`);

  cart = {};
  saveCart();
  updateCartUI();

  nameEl.value = "";
  phoneEl.value = "";

  setTimeout(closeCartModal, 900);
};

/* ============================================================
   TOAST
   ============================================================ */
let toastTimer;
function toast(msg){
  const t = $("#toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=> t.classList.remove("show"), 2400);
}

/* ============================================================
   NAV
   ============================================================ */
window.addEventListener("scroll", ()=>{
  $("#nav").classList.toggle("scrolled", window.scrollY > 10);
}, { passive:true });

$("#menuToggle").onclick = ()=>{
  const links = $("#navLinks");
  const open = links.classList.toggle("open");
  $("#menuToggle").setAttribute("aria-expanded", open ? "true" : "false");
};
$$(".nav-links a").forEach(a=>{
  a.onclick = ()=>{
    $("#navLinks").classList.remove("open");
    $("#menuToggle").setAttribute("aria-expanded","false");
  };
});
document.addEventListener("click", e=>{
  const links = $("#navLinks");
  if(!links.classList.contains("open")) return;
  if(!links.contains(e.target) && !$("#menuToggle").contains(e.target)){
    links.classList.remove("open");
    $("#menuToggle").setAttribute("aria-expanded","false");
  }
});

/* ============================================================
   REVEAL ON SCROLL
   ============================================================ */
let io;
function observeReveals(){
  if(!("IntersectionObserver" in window)){
    $$(".reveal").forEach(el=>el.classList.add("in"));
    return;
  }
  if(!io){
    io = new IntersectionObserver(entries=>{
      entries.forEach(en=>{
        if(en.isIntersecting){
          en.target.classList.add("in");
          io.unobserve(en.target);
        }
      });
    }, { threshold:.12, rootMargin:"0px 0px -40px 0px" });
  }
  $$(".reveal:not(.in)").forEach(el=> io.observe(el));
}

/* ============================================================
   INIT
   ============================================================ */
$("#year").textContent = new Date().getFullYear();
renderChips();
renderProducts(false);
updateCartUI();
observeReveals();
</script>
